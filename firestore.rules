rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para el Sistema POS TuBodeguitaDeConfianza
    match /productos/{productoId} {
      allow read, write: if true;
    }
    match /clientes/{clienteId} {
      allow read, write: if true;
    }
    match /ventas/{ventaId} {
      allow read, write: if true;
    }
    match /abonos/{abonoId} {
      allow read, write: if true;
    }
    match /transacciones/{txId} {
      allow read, write: if true;
    }
    match /auditorias/{auditoriaId} {
      allow read, write: if true;
    }
    match /sesiones_conteo/{sesionId} {
      allow read, write: if true;
    }
    match /eliminaciones/{eliminacionId} {
      allow read, write: if true;
    }
    match /clientesEliminados/{cliEliminadoId} {
      allow read, write: if true;
    }
    match /usuarios/{usuarioId} {
      allow read, write: if true;
    }
    match /canjesPremios/{canjeId} {
      allow read, write: if true;
    }
    match /config/{configId} {
      allow read, write: if true;
    }
    match /app_state/{stateId} {
      allow read, write: if true;
    }
    match /PagosPorVerificar/{pagoId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /users/{userId}/{allSubcollections=**} {
      allow read, write: if true;
    }
    match /combos/{comboId} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /sales_history/{saleId} {
      allow read, write: if true;
    }
    match /payments_and_credits/{paymentId} {
      allow read, write: if true;
    }
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    match /notifications/{notifId} {
      allow read, write: if true;
    }
    match /proveedores/{proveedorId} {
      allow read, write: if true;
    }
    match /facturas_compras/{facturaId} {
      allow read, write: if true;
    }
    match /kardex_inventario/{kardexId} {
      allow read, write: if true;
    }
    match /cajas_turnos/{turnoId} {
      allow read, write: if true;
    }
    match /egresos_caja/{egresoId} {
      allow read, write: if true;
    }
    match /resenas_sugerencias/{resenaId} {
      allow read: if true;
      allow create, update: if request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 5
        && request.resource.data.comentario.size() <= 600
        && request.resource.data.calificacion is number
        && request.resource.data.calificacion >= 1
        && request.resource.data.calificacion <= 5;
      allow delete: if true;
    }
    match /pedidos_adelantados/{pedidoId} {
      allow read: if true;
      allow create, update: if request.resource.data.clienteNombre is string
        && request.resource.data.clienteNombre.size() >= 1
        && request.resource.data.clienteNombre.size() <= 120
        && request.resource.data.modalidadEntrega in ['RETIRO_TIENDA', 'DELIVERY']
        && request.resource.data.estado in ['PENDIENTE', 'PREPARANDO', 'LISTO', 'COMPLETADO', 'CANCELADO']
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 100
        && request.resource.data.totalUSD is number
        && request.resource.data.totalUSD >= 0;
      allow delete: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
